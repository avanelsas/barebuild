;; Dependency versions are declared here and again in deps.edn, which says what the
;; published jar depends on. Keep the two in step.
;; barereplay is a demo-only dependency and is excluded from the published jar by build.clj,
;; which ships src/ alone. Its own barebuild dependency is excluded because that is this
;; repo's source: both on the classpath would duplicate every barebuild namespace.
{:source-paths ["src" "test" "demo/src" "demo/test"]
 :dependencies [[com.github.avanelsas/baredom "3.8.0"]
                [com.github.avanelsas/barereplay "0.4.0"
                 :exclusions [com.github.avanelsas/barebuild
                              com.github.avanelsas/baredom]]]

 ;; Serves the demo pages over http during `watch lib`, at /demo/index.html and /demo/board.html.
 ;; They must be served rather than opened as files: the shadow-cljs REPL client builds its
 ;; websocket URL from the document host, which a file:// page does not have. The API stays on the
 ;; bb dev-server at :8090, cross-origin, which its CORS headers already allow.
 :dev-http {8081 "."}

 :builds
 {:lib
  {:target    :esm
   :output-dir "dist"
   :modules
   {:base {:entries []}
    :core {:exports    {init barebuild.core/init}
           :depends-on #{:base}}
    :demo {:exports    {init demo.app/init}
           :depends-on #{:core}}}}

  ;; .cjs, not .js: package.json declares "type": "module", which would make Node read
  ;; the CommonJS test bundle as ESM.
  :test
  {:target    :node-test
   :output-to "out/node-tests.cjs"
   :ns-regexp "^(?!barebuild\\.browser\\.).*-test$"}

  :test-karma
  {:target    :karma
   :output-to "out/karma/test.js"
   :ns-regexp "^barebuild\\.browser\\..*-test$"}}}
